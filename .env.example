# Bu dosyayı .env olarak kopyalayın. `npm run init-project` bunu sizin için yapar.

NODE_ENV=development

# Uygulama
APP_URL=http://localhost:3000
# En az 32 karakter. Üretmek için: openssl rand -base64 32
AUTH_SECRET=

# Veritabanı (docker-compose.yml ile aynı değerler)
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
DB_PORT=5433
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5433/ecommerce

# E-posta (geliştirmede Mailpit: arayüz http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="E-Ticaret <no-reply@localhost>"
SMTP_USER=
SMTP_PASSWORD=

# Yüklenen görsellerin saklandığı dizin (üretimde kalıcı volume olmalı)
UPLOAD_DIR=./uploads

# PayTR (yalnızca production'da zorunlu)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Canlı ortamda deneme için true yapılabilir (development'ta her zaman test modudur)
PAYTR_TEST_MODE=false

# Cloudflare Turnstile (captcha özelliği açıksa kullanılır)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analitik (isteğe bağlı; çerez onayı verilmeden yüklenmez)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
