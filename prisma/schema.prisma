// E-ticaret şablonu veri modeli.
// Para alanları Decimal(12,2); para birimi her kayıtta `currency` olarak tutulur.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enumlar ─────────────────────────────

enum UserType {
  CUSTOMER
  STAFF
}

enum B2BStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AttributeType {
  SELECT
  MULTI_SELECT
}

enum DiscountType {
  PERCENT
  FIXED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethodType {
  CARD
  BANK_TRANSFER
  DEFERRED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ShipmentStatus {
  PREPARING
  SHIPPED
  DELIVERED
  RETURNED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum InvoiceType {
  INDIVIDUAL
  CORPORATE
}

// ───────────────────────── Kullanıcı ve yetki ─────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  firstName        String
  lastName         String
  phone            String?
  type             UserType  @default(CUSTOMER)
  isActive         Boolean   @default(true)
  emailVerifiedAt  DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  anonymizedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer  Customer?
  roles     UserRole[]
  addresses Address[]
  carts     Cart[]
  orders    Order[]
  wishlist  WishlistItem[]
  auditLogs AuditLog[]

  @@index([type])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  roleId     String
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ───────────────────────────── Müşteri / B2B ─────────────────────────────

model CustomerGroup {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  /// Gruba liste fiyatı üzerinden uygulanan yüzde iskonto (0-100)
  discountPercent Decimal? @db.Decimal(5, 2)
  createdAt       DateTime @default(now())

  customers   Customer[]
  groupPrices VariantGroupPrice[]
  tierPrices  TierPrice[]
}

model Customer {
  id             String    @id @default(cuid())
  userId         String    @unique
  groupId        String?
  b2bStatus      B2BStatus @default(NONE)
  companyName    String?
  taxNumber      String?
  taxOffice      String?
  creditLimit    Decimal?  @db.Decimal(12, 2)
  minOrderAmount Decimal?  @db.Decimal(12, 2)
  approvedAt     DateTime?
  /// Başvuru değerlendirme notu (ret nedeni vb.)
  b2bNote        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([b2bStatus])
}

model Address {
  id                String      @id @default(cuid())
  userId            String
  title             String
  firstName         String
  lastName          String
  phone             String
  city              String
  district          String
  neighborhood      String?
  addressLine       String
  postalCode        String?
  invoiceType       InvoiceType @default(INDIVIDUAL)
  nationalId        String?
  companyName       String?
  taxNumber         String?
  taxOffice         String?
  isDefaultShipping Boolean     @default(false)
  isDefaultBilling  Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Katalog ─────────────────────────────

model Category {
  id             String   @id @default(cuid())
  parentId       String?
  name           String
  slug           String   @unique
  description    String?
  imageUrl       String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String?
  status         ProductStatus @default(DRAFT)
  categoryId     String
  brandId        String?
  /// KDV oranı, yüzde (örn. 20)
  taxRate        Decimal       @default(20) @db.Decimal(5, 2)
  /// false ise stok takibi yapılmaz, ürün sınırsız stoklu sayılır
  trackInventory Boolean       @default(true)
  desi           Decimal?      @db.Decimal(8, 2)
  weightGram     Int?
  isFeatured     Boolean       @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category   Category                @relation(fields: [categoryId], references: [id])
  brand      Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  options    ProductOption[]
  variants   ProductVariant[]
  images     ProductImage[]
  attributes ProductAttributeValue[]
  wishlist   WishlistItem[]
  related    RelatedProduct[]        @relation("RelatedFrom")
  relatedTo  RelatedProduct[]        @relation("RelatedTo")

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
}

/// Varyant ekseni (örn. Renk, Beden)
model ProductOption {
  id        String @id @default(cuid())
  productId String
  name      String
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
}

model ProductOptionValue {
  id       String @id @default(cuid())
  optionId String
  value    String
  position Int    @default(0)

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]
  images   ProductImage[]

  @@unique([optionId, value])
}

/// Satılan birim: her eksen kombinasyonunun kendi SKU, stok ve fiyatı vardır
model ProductVariant {
  id               String   @id @default(cuid())
  productId        String
  sku              String   @unique
  barcode          String?
  price            Decimal  @db.Decimal(12, 2)
  compareAtPrice   Decimal? @db.Decimal(12, 2)
  currency         String   @default("TRY")
  stockQuantity    Int      @default(0)
  reservedQuantity Int      @default(0)
  desi             Decimal? @db.Decimal(8, 2)
  weightGram       Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product      Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  groupPrices  VariantGroupPrice[]
  tierPrices   TierPrice[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reservations StockReservation[]
  stockAlerts  BackInStockSubscription[]

  @@index([productId])
}

model VariantOptionValue {
  variantId     String
  optionValueId String

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
}

/// Ürün görseli. `optionValueId` doluysa görsel o seçeneğe (örn. renk) özeldir.
model ProductImage {
  id            String   @id @default(cuid())
  productId     String
  optionValueId String?
  url           String
  alt           String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)

  @@index([productId, position])
}

model Attribute {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  type         AttributeType @default(SELECT)
  isFilterable Boolean       @default(true)
  position     Int           @default(0)

  values AttributeValue[]
}

model AttributeValue {
  id          String @id @default(cuid())
  attributeId String
  value       String
  slug        String
  position    Int    @default(0)

  attribute Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products  ProductAttributeValue[]

  @@unique([attributeId, slug])
}

model ProductAttributeValue {
  productId        String
  attributeValueId String

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
}

/// Elle seçilen benzer ürün; yoksa kural tabanlı strateji devreye girer
model RelatedProduct {
  productId        String
  relatedProductId String
  position         Int    @default(0)

  product        Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("RelatedTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
}

/// Slug değişince eski adresten yeni adrese yönlendirme
model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

// ───────────────────────────── B2B fiyatlandırma ─────────────────────────────

model VariantGroupPrice {
  variantId String
  groupId   String
  price     Decimal @db.Decimal(12, 2)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  group   CustomerGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([variantId, groupId])
}

/// Adet kademeli fiyat; `groupId` boşsa tüm müşteriler için geçerlidir
model TierPrice {
  id          String  @id @default(cuid())
  variantId   String
  groupId     String?
  minQuantity Int
  price       Decimal @db.Decimal(12, 2)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  group   CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([variantId, groupId, minQuantity])
}

// ───────────────────────────── Sepet ve stok ─────────────────────────────

model Cart {
  id           String   @id @default(cuid())
  userId       String?
  sessionToken String?  @unique
  currency     String   @default("TRY")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model StockReservation {
  id        String            @id @default(cuid())
  variantId String
  orderId   String?
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([variantId])
}

model BackInStockSubscription {
  id         String    @id @default(cuid())
  variantId  String
  email      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, email])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

// ───────────────────────────── İndirim ─────────────────────────────

model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  type             DiscountType
  value            Decimal      @db.Decimal(12, 2)
  minSubtotal      Decimal?     @db.Decimal(12, 2)
  maxUses          Int?
  perCustomerLimit Int?
  usedCount        Int          @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
}

/// Otomatik uygulanan kampanya. Kural tipi `ruleType`, parametreleri `config` içindedir
/// (DiscountRule stratejisi ile çözülür).
model Campaign {
  id        String    @id @default(cuid())
  name      String
  ruleType  String
  config    Json
  priority  Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

// ───────────────────────────── Sipariş ve ödeme ─────────────────────────────

model Order {
  id              String        @id @default(cuid())
  /// Tahmin edilemez, kullanıcıya gösterilen sipariş numarası
  orderNumber     String        @unique
  userId          String?
  guestEmail      String?
  /// Misafir sipariş takibi için tahmin edilemez bağlantı belirteci
  lookupToken     String        @unique
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus @default(PENDING)
  /// Siparişin geldiği kanal: web, trendyol, ...
  source          String        @default("web")
  currency        String        @default("TRY")
  subtotal        Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(12, 2)
  shippingTotal   Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal       @db.Decimal(12, 2)
  couponCode      String?
  shippingAddress Json
  billingAddress  Json
  customerNote    String?
  /// Ödeme tamamlanınca temizlenecek sepet
  cartId          String?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]
  shipments    Shipment[]
  returns      ReturnRequest[]
  reservations StockReservation[]

  @@index([userId])
  @@index([guestEmail])
  @@index([status])
  @@index([createdAt])
}

/// Sipariş anındaki ürün bilgisinin kopyası; katalog değişse de sipariş değişmez
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  variantId   String?
  productName String
  variantName String?
  sku         String
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @db.Decimal(5, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  order   Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returns ReturnRequestItem[]

  @@index([orderId])
}

model Payment {
  id          String            @id @default(cuid())
  orderId     String
  provider    String
  method      PaymentMethodType @default(CARD)
  status      PaymentStatus     @default(PENDING)
  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("TRY")
  /// Sağlayıcıya gönderilen benzersiz sipariş kimliği (PayTR merchant_oid)
  merchantOid String            @unique
  providerRef String?
  rawPayload  Json?
  paidAt      DateTime?
  /// Vadeli ödemede vade tarihi
  dueAt       DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
}

model Refund {
  id          String       @id @default(cuid())
  paymentId   String
  amount      Decimal      @db.Decimal(12, 2)
  status      RefundStatus @default(PENDING)
  reason      String?
  providerRef String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  carrier        String
  trackingNumber String?
  status         ShipmentStatus @default(PREPARING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ReturnRequest {
  id         String       @id @default(cuid())
  orderId    String
  status     ReturnStatus @default(REQUESTED)
  reason     String
  note       String?
  adminNote  String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  order Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ReturnRequestItem[]

  @@index([orderId])
  @@index([status])
}

model ReturnRequestItem {
  id              String @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── İçerik ve ayarlar ─────────────────────────────

model Banner {
  id        String    @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  sortOrder Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  content        String
  isPublished    Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Menu {
  id    String     @id @default(cuid())
  key   String     @unique
  items MenuItem[]
}

model MenuItem {
  id       String  @id @default(cuid())
  menuId   String
  parentId String?
  label    String
  url      String
  position Int     @default(0)

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuTree")

  @@index([menuId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Değiştirilemez denetim kaydı; uygulama katmanı yalnızca ekleme yapar
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

/// Sabit pencereli istek sayacı (rate limiting). Eski kayıtlar periyodik temizlenir.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}
